{
  "name": "@shieldbow/web",
  "version": "1.1.1",
  "description": "A browser-safe, lightweight part of the shieldbow library.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "watch": "tsc && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "format": "prettier --write \"src/**/**.ts\" \"tests/**/**.ts\"",
    "lint": "eslint --fix --color \"src/**/**.ts\" \"tests/**/**.ts\"",
    "format:test": "prettier --check \"src/**/**.ts\" \"tests/**/**.ts\"",
    "lint:test": "eslint --color \"src/**/**.ts\" \"tests/**/**.ts\"",
    "pretest": "run-s format:test lint:test build",
    "test": "jest --runInBand",
    "extract": "api-extractor run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheDrone7/shieldbow.git"
  },
  "keywords": [
    "lol",
    "shieldbow",
    "league",
    "leagueoflegends",
    "typescript",
    "ts",
    "javascript",
    "js",
    "web"
  ],
  "author": "TheDrone7 <h@thedrone7.dev> (https://thedrone7.dev)",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/TheDrone7/shieldbow/issues"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/TheDrone7/shieldbow#readme",
  "dependencies": {
    "@discordjs/collection": "2.1.1",
    "@shieldbow/cache": "workspace:^",
    "html-escaper": "^3.0.3",
    "tslib": "^2.8.1"
  },
  "optionalDependencies": {
    "axios": "^1.9.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.26.0",
    "@microsoft/api-extractor": "^7.52.7",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/parser": "^8.31.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.3.1",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.15",
    "typescript": "^5.8.3"
  }
}
